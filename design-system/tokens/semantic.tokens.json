      "$value": {
        "fontFamily": "{typography.family.display}",
        "fontSize": "{typography.size.md}",
        "fontWeight": "{typography.weight.semibold}",
        "lineHeight": "{typography.line-height.snug}",
        "letterSpacing": "{typography.letter-spacing.none}"
      },
      "$description": "Título de tarjeta ('Frontside snap')."
    },
    "body-large": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.body}",
        "fontSize": "{typography.size.md}",
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": "{typography.line-height.normal}",
        "letterSpacing": "{typography.letter-spacing.none}"
      },
      "$description": "Texto de lectura destacado."
    },
    "body-medium": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.body}",
        "fontSize": "{typography.size.sm}",
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": "{typography.line-height.normal}",
        "letterSpacing": "{typography.letter-spacing.none}"
      },
      "$description": "Texto de lectura por defecto."
    },
    "body-small": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.body}",
        "fontSize": "{typography.size.xs}",
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": "{typography.line-height.normal}",
        "letterSpacing": "{typography.letter-spacing.none}"
      },
      "$description": "Metadatos y texto de ayuda."
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.body}",
        "fontSize": "{typography.size.2xs}",
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": "{typography.line-height.normal}",
        "letterSpacing": "{typography.letter-spacing.none}"
      },
      "$description": "Fechas y notas mínimas."
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.display}",
        "fontSize": "{typography.size.sm}",
        "fontWeight": "{typography.weight.medium}",
        "lineHeight": "{typography.line-height.snug}",
        "letterSpacing": "{typography.letter-spacing.wide}"
      },
      "$description": "Labels de formulario."
    },
    "button": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.display}",
        "fontSize": "{typography.size.sm}",
        "fontWeight": "{typography.weight.semibold}",
        "lineHeight": "{typography.line-height.snug}",
        "letterSpacing": "{typography.letter-spacing.wide}"
      },
      "$description": "Texto de botones."
    },
    "overline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.display}",
        "fontSize": "{typography.size.2xs}",
        "fontWeight": "{typography.weight.semibold}",
        "lineHeight": "{typography.line-height.normal}",
        "letterSpacing": "{typography.letter-spacing.wider}"
      },
      "$description": "Etiquetas en mayúsculas (EMAIL, FROM SURFER)."
    },
    "metric": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.display}",
        "fontSize": "{typography.size.2xl}",
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": "{typography.line-height.tight}",
        "letterSpacing": "{typography.letter-spacing.none}"
      },
      "$description": "Valores numéricos de stats."
    }
  },
  "elevation": {
    "action": {
      "$type": "shadow",
      "$value": "{shadow.glow-medium}",
      "$description": "Brillo de la acción primaria."
    },
    "accent": {
      "$type": "shadow",
      "$value": "{shadow.glow-small}",
      "$description": "Brillo sutil de avatares y badges destacados."
    },
    "overlay": {
      "$type": "shadow",
      "$value": "{shadow.elevation-high}",
      "$description": "Modales, tooltips y menús."
    },
    "focus": {
      "$type": "shadow",
      "$value": "{shadow.ring}",
      "$description": "Anillo de foco visible para teclado."
    }
  },
  "motion": {
    "transition-fast": {
      "$type": "transition",
      "$value": {
        "duration": "{motion.duration.fast}",
        "delay": "0ms",
        "timingFunction": "{motion.easing.standard}"
      },
      "$description": "Hover y cambios de color."
    },
    "transition-base": {
      "$type": "transition",
      "$value": {
        "duration": "{motion.duration.base}",
        "delay": "0ms",
        "timingFunction": "{motion.easing.standard}"
      },
      "$description": "Expandir/colapsar, switches."
    },
    "transition-enter": {
      "$type": "transition",
      "$value": {
        "duration": "{motion.duration.slow}",
        "delay": "0ms",
        "timingFunction": "{motion.easing.enter}"
      },
      "$description": "Entrada de modales y toasts."
    },
    "reduced-duration": {
      "$type": "duration",
      "$value": "{motion.duration.instant}",
      "$description": "Duración cuando el usuario pide movimiento reducido (prefers-reduced-motion)."
    },
    "loop-duration": {
      "$type": "duration",
      "$value": "{motion.duration.loop}",
      "$description": "Vuelta completa de animaciones en bucle (Spinner)."
    }
  },
  "layer": {
    "$description": "Orden de apilado por intención. Usar estos, nunca z-index numéricos.",
    "raised": {
      "$type": "number",
      "$value": "{z-index.raised}",
      "$description": "Elementos sobre el contenido (cards en hover)."
    },
    "sticky": {
      "$type": "number",
      "$value": "{z-index.sticky}",
      "$description": "Cabeceras fijas."
    },
    "dropdown": {
      "$type": "number",
      "$value": "{z-index.dropdown}",
      "$description": "Menús desplegables."
    },
    "modal": {
      "$type": "number",
      "$value": "{z-index.modal}",
      "$description": "Modales."
    },
    "toast": {
      "$type": "number",
      "$value": "{z-index.toast}",
      "$description": "Notificaciones flotantes."
    },
    "tooltip": {
      "$type": "number",
      "$value": "{z-index.tooltip}",
      "$description": "Tooltips, siempre encima."
    }
  }
}
