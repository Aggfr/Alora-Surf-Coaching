{
  "$description": "Layer 2: usage intent. Dark theme (the default; it is the theme of the current designs).",
  "color": {
    "background": {
      "canvas": {
        "$type": "color",
        "$value": "{color.navy.950}",
        "$description": "Page background. Lowest layer."
      },
      "surface": {
        "$type": "color",
        "$value": "{color.navy.900}",
        "$description": "Structural surfaces: sidebar, panels."
      },
      "surface-raised": {
        "$type": "color",
        "$value": "{color.navy.800}",
        "$description": "Cards, stats, lists and fields on the canvas."
      },
      "surface-sunken": {
        "$type": "color",
        "$value": "{color.alpha.navy.18}",
        "$description": "Sunken areas inside a card (surfer quote, notes block)."
      },
      "brand-subtle": {
        "$type": "color",
        "$value": "{color.alpha.ocean.12}",
        "$description": "Background of selected or brand-highlighted elements."
      },
      "highlight-subtle": {
        "$type": "color",
        "$value": "{color.alpha.sun.12}",
        "$description": "Background of plan badges and warm highlights."
      },
      "overlay": {
        "$type": "color",
        "$value": "{color.alpha.black.55}",
        "$description": "Scrim behind modals."
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.navy.50}",
        "$description": "Tooltip background."
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Primary text: headings, values, content."
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.navy.300}",
        "$description": "Supporting text: subtitles, metadata, stat labels."
      },
      "tertiary": {
        "$type": "color",
        "$value": "{color.navy.400}",
        "$description": "Low-priority text: placeholders, dates, metadata. Minimum contrast 4.5:1 on surface-raised."
      },
      "brand": {
        "$type": "color",
        "$value": "{color.ocean.400}",
        "$description": "Links and brand-colored text."
      },
      "highlight": {
        "$type": "color",
        "$value": "{color.sun.400}",
        "$description": "Warm highlighted text (surfer plan)."
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.navy.950}",
        "$description": "Text on inverse backgrounds (tooltips)."
      },
      "on-action": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Text on primary or destructive actions."
      },
      "disabled": {
        "$type": "color",
        "$value": "{color.navy.500}",
        "$description": "Text of disabled elements."
      },
      "muted": {
        "$type": "color",
        "$value": "{color.text.tertiary}",
        "$description": "Migration alias.",
        "$deprecated": "Use color.text.tertiary. 'muted' was this color's name in Coach Platform; kept as an alias until v2.0.0."
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "{color.alpha.ocean.18}",
        "$description": "Default border for cards, fields and dividers."
      },
      "default": {
        "$type": "color",
        "$value": "{color.navy.500}",
        "$description": "Stronger border: unchecked checkbox and radio."
      },
      "strong": {
        "$type": "color",
        "$value": "{color.alpha.white.40}",
        "$description": "High-contrast border: secondary button on hover."
      },
      "brand": {
        "$type": "color",
        "$value": "{color.ocean.400}",
        "$description": "Border of active or selected elements."
      },
      "focus": {
        "$type": "color",
        "$value": "{color.ocean.400}",
        "$description": "Visible focus border and ring."
      },
      "danger": {
        "$type": "color",
        "$value": "{color.coral.400}",
        "$description": "Border of fields with an error."
      }
    },
    "action": {
      "primary": {
        "background": {
          "$type": "color",
          "$value": "{color.ocean.700}",
          "$description": "Main action of the view. One per view. Darker than the original design so white text meets 4.5:1."
        },
        "background-start": {
          "$type": "color",
          "$value": "{color.ocean.800}",
          "$description": "Start of the primary button gradient. The original (#3b8eaa → #5aaec8) gave 2.5–3.7:1 with white text; ocean.800 → ocean.700 guarantees ≥ 5.4:1 across the whole gradient."
        },
        "background-end": {
          "$type": "color",
          "$value": "{color.ocean.700}",
          "$description": "End of the primary button gradient."
        },
        "background-hover": {
          "$type": "color",
          "$value": "{color.ocean.800}",
          "$description": "Main action on hover."
        },
        "background-pressed": {
          "$type": "color",
          "$value": "{color.ocean.900}",
          "$description": "Main action when pressed."
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.white}",
          "$description": "Text and icon on the main action."
        }
      },
      "secondary": {
        "background": {
          "$type": "color",
          "$value": "{color.navy.800}",
          "$description": "Secondary action."
        },
        "background-hover": {
          "$type": "color",
          "$value": "{color.navy.700}",
          "$description": "Secondary action on hover."
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.navy.300}",
          "$description": "Secondary action text."
        },
        "border": {
          "$type": "color",
          "$value": "{color.alpha.ocean.18}",
          "$description": "Secondary action border."
        }
      },
      "ghost": {
        "background-hover": {
          "$type": "color",
          "$value": "{color.alpha.ocean.8}",
          "$description": "Hover background of actions without a container."
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.ocean.400}",
          "$description": "Text of link-style actions."
        }
      },
      "danger": {
        "background": {
          "$type": "color",
          "$value": "{color.coral.600}",
          "$description": "Destructive action (cancel plan). Dark tone so white text meets 4.5:1."
        },
        "background-hover": {
          "$type": "color",
          "$value": "{color.coral.700}",
          "$description": "Destructive action on hover."
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.coral.300}",
          "$description": "Destructive action text without a container (Sign out)."
        }
      }
    },
    "feedback": {
      "success": {
        "foreground": {
          "$type": "color",
          "$value": "{color.green.400}"
        },
        "background": {
          "$type": "color",
          "$value": "{color.alpha.green.12}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.alpha.green.18}"
        }
      },
      "warning": {
        "foreground": {
          "$type": "color",
          "$value": "{color.amber.500}"
        },
        "background": {
          "$type": "color",
          "$value": "{color.alpha.amber.12}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.alpha.amber.18}"
        }
      },
      "danger": {
        "foreground": {
          "$type": "color",
          "$value": "{color.coral.300}"
        },
        "background": {
          "$type": "color",
          "$value": "{color.alpha.coral.12}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.alpha.coral.18}"
        }
      },
      "info": {
        "foreground": {
          "$type": "color",
          "$value": "{color.ocean.400}"
        },
        "background": {
          "$type": "color",
          "$value": "{color.alpha.ocean.12}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.alpha.ocean.18}"
        }
      },
      "neutral": {
        "foreground": {
          "$type": "color",
          "$value": "{color.navy.300}"
        },
        "background": {
          "$type": "color",
          "$value": "{color.alpha.gray.18}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.alpha.gray.18}"
        }
      }
    },
    "plan": {
      "pay-as-you-go": {
        "foreground": {
          "$type": "color",
          "$value": "{color.navy.300}",
          "$description": "Plan Pay as you go."
        },
        "background": {
          "$type": "color",
          "$value": "{color.alpha.gray.18}"
        }
      },
      "elite": {
        "foreground": {
          "$type": "color",
          "$value": "{color.amber.500}",
          "$description": "Plan Elite."
        },
        "background": {
          "$type": "color",
          "$value": "{color.alpha.amber.18}"
        }
      },
      "progression": {
        "foreground": {
          "$type": "color",
          "$value": "{color.violet.400}",
          "$description": "Plan Progression."
        },
        "background": {
          "$type": "color",
          "$value": "{color.alpha.violet.18}"
        }
      }
    },
    "status": {
      "pending": {
        "foreground": {
          "$type": "color",
          "$value": "{color.sun.400}",
          "$description": "Submission waiting for review."
        },
        "background": {
          "$type": "color",
          "$value": "{color.alpha.sun.12}"
        }
      },
      "in-review": {
        "foreground": {
          "$type": "color",
          "$value": "{color.ocean.400}",
          "$description": "Submission being reviewed by the coach."
        },
        "background": {
          "$type": "color",
          "$value": "{color.alpha.ocean.12}"
        }
      },
      "review-ready": {
        "foreground": {
          "$type": "color",
          "$value": "{color.green.400}",
          "$description": "Review ready to watch."
        },
        "background": {
          "$type": "color",
          "$value": "{color.alpha.green.12}"
        }
      },
      "overdue": {
        "foreground": {
          "$type": "color",
          "$value": "{color.coral.300}",
          "$description": "Review past its deadline."
        },
        "background": {
          "$type": "color",
          "$value": "{color.alpha.coral.12}"
        }
      }
    },
    "disabled": {
      "background": {
        "$type": "color",
        "$value": "{color.alpha.navy.18}",
        "$description": "Background of disabled controls."
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.navy.500}",
        "$description": "Text and icon of disabled controls."
      }
    },
    "icon": {
      "primary": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Default icons."
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.navy.500}",
        "$description": "Secondary icons (inactive navigation, chevrons)."
      },
      "brand": {
        "$type": "color",
        "$value": "{color.ocean.400}",
        "$description": "Active or brand icons."
      }
    }
  },
  "size": {
    "space": {
      "none": {
        "$type": "dimension",
        "$value": "{size.space.0}"
      },
      "3xs": {
        "$type": "dimension",
        "$value": "{size.space.50}",
        "$description": "Minimum gap between a label and its value."
      },
      "2xs": {
        "$type": "dimension",
        "$value": "{size.space.100}",
        "$description": "Inner spacing of badges and chips."
      },
      "xs": {
        "$type": "dimension",
        "$value": "{size.space.150}",
        "$description": "Gap between icon and text in small controls."
      },
      "small": {
        "$type": "dimension",
        "$value": "{size.space.200}",
        "$description": "Gap between icon and text; between closely related elements."
      },
      "medium": {
        "$type": "dimension",
        "$value": "{size.space.300}",
        "$description": "Inner padding of compact cards and fields."
      },
      "large": {
        "$type": "dimension",
        "$value": "{size.space.400}",
        "$description": "Card padding; gap between list items."
      },
      "xl": {
        "$type": "dimension",
        "$value": "{size.space.600}",
        "$description": "Gap between sections within a view."
      },
      "2xl": {
        "$type": "dimension",
        "$value": "{size.space.1000}",
        "$description": "Gap between large page blocks."
      },
      "page-gutter": {
        "$type": "dimension",
        "$value": "{size.space.3000}",
        "$description": "Side margin of the content on desktop (1440px)."
      }
    },
    "radius": {
      "none": {
        "$type": "dimension",
        "$value": "{size.radius.0}"
      },
      "small": {
        "$type": "dimension",
        "$value": "{size.radius.100}",
        "$description": "Badges, tags, checkbox."
      },
      "medium": {
        "$type": "dimension",
        "$value": "{size.radius.200}",
        "$description": "Tooltips, menu items."
      },
      "large": {
        "$type": "dimension",
        "$value": "{size.radius.300}",
        "$description": "Fields, buttons, inner blocks."
      },
      "xl": {
        "$type": "dimension",
        "$value": "{size.radius.400}",
        "$description": "Cards, stats, modals."
      },
      "pill": {
        "$type": "dimension",
        "$value": "{size.radius.full}",
        "$description": "Pills, avatars, switch."
      }
    },
    "layout": {
      "sidebar-width": {
        "$type": "dimension",
        "$value": "{size.container.sidebar}",
        "$description": "Navigation sidebar width on desktop."
      },
      "form-width": {
        "$type": "dimension",
        "$value": "{size.container.form}",
        "$description": "Maximum width of authentication forms."
      },
      "content-width": {
        "$type": "dimension",
        "$value": "{size.container.content}",
        "$description": "Maximum width of the content column."
      },
      "control-height": {
        "$type": "dimension",
        "$value": "{size.control.md}",
        "$description": "Default height of buttons and fields (44px touch target)."
      },
      "control-height-small": {
        "$type": "dimension",
        "$value": "{size.control.sm}"
      },
      "control-height-large": {
        "$type": "dimension",
        "$value": "{size.control.lg}"
      },
      "target-minimum": {
        "$type": "dimension",
        "$value": "{size.space.600}",
        "$description": "Smallest hit area for any pointer target, including icon-only buttons inside other components (WCAG 2.2 target size, 24px)."
      },
      "stat-min-width": {
        "$type": "dimension",
        "$value": "{size.container.stat}",
        "$description": "Minimum width of a Stat before it wraps to a new row."
      }
    },
    "icon": {
      "extra-small": {
        "$type": "dimension",
        "$value": "{size.icon.xs}",
        "$description": "Icons inside badges, tags and checkbox."
      },
      "small": {
        "$type": "dimension",
        "$value": "{size.icon.sm}",
        "$description": "Icons inside fields and small buttons."
      },
      "medium": {
        "$type": "dimension",
        "$value": "{size.icon.md}",
        "$description": "Icons in buttons and section headers."
      },
      "large": {
        "$type": "dimension",
        "$value": "{size.icon.lg}",
        "$description": "Navigation icons (default size)."
      },
      "extra-large": {
        "$type": "dimension",
        "$value": "{size.icon.xl}",
        "$description": "Illustrative EmptyState icons."
      }
    },
    "border": {
      "default": {
        "$type": "dimension",
        "$value": "{size.border.100}"
      },
      "emphasis": {
        "$type": "dimension",
        "$value": "{size.border.150}",
        "$description": "Line icons and checkbox."
      },
      "focus": {
        "$type": "dimension",
        "$value": "{size.border.200}"
      }
    }
  },
  "typography": {
    "$description": "Composite type roles. Always use a role; never combine size and weight by hand.",
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.display}",
        "fontSize": "{typography.size.4xl}",
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": "{typography.line-height.tight}",
        "letterSpacing": "{typography.letter-spacing.none}"
      },
      "$description": "Main greeting of the view ('Welcome, Alejandro')."
    },
    "heading-large": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.display}",
        "fontSize": "{typography.size.2xl}",
        "fontWeight": "{typography.weight.bold}",
        "lineHeight": "{typography.line-height.tight}",
        "letterSpacing": "{typography.letter-spacing.none}"
      },
      "$description": "Page or modal title."
    },
    "heading-medium": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.display}",
        "fontSize": "{typography.size.xl}",
        "fontWeight": "{typography.weight.semibold}",
        "lineHeight": "{typography.line-height.snug}",
        "letterSpacing": "{typography.letter-spacing.none}"
      },
      "$description": "Section title."
    },
    "heading-small": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.display}",
        "fontSize": "{typography.size.md}",
        "fontWeight": "{typography.weight.semibold}",
        "lineHeight": "{typography.line-height.snug}",
        "letterSpacing": "{typography.letter-spacing.none}"
      },
      "$description": "Card title ('Frontside snap')."
    },
    "body-large": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.body}",
        "fontSize": "{typography.size.md}",
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": "{typography.line-height.normal}",
        "letterSpacing": "{typography.letter-spacing.none}"
      },
      "$description": "Emphasized reading text."
    },
    "body-medium": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.body}",
        "fontSize": "{typography.size.sm}",
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": "{typography.line-height.normal}",
        "letterSpacing": "{typography.letter-spacing.none}"
      },
      "$description": "Default reading text."
    },
    "body-small": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.body}",
        "fontSize": "{typography.size.xs}",
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": "{typography.line-height.normal}",
        "letterSpacing": "{typography.letter-spacing.none}"
      },
      "$description": "Metadata and helper text."
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.body}",
        "fontSize": "{typography.size.2xs}",
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": "{typography.line-height.normal}",
        "letterSpacing": "{typography.letter-spacing.none}"
      },
      "$description": "Dates and minimal notes."
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.display}",
        "fontSize": "{typography.size.sm}",
        "fontWeight": "{typography.weight.medium}",
        "lineHeight": "{typography.line-height.snug}",
        "letterSpacing": "{typography.letter-spacing.wide}"
      },
      "$description": "Form labels."
    },
    "button": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.display}",
        "fontSize": "{typography.size.sm}",
        "fontWeight": "{typography.weight.semibold}",
        "lineHeight": "{typography.line-height.snug}",
        "letterSpacing": "{typography.letter-spacing.wide}"
      },
      "$description": "Button text."
    },
    "overline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.display}",
        "fontSize": "{typography.size.2xs}",
        "fontWeight": "{typography.weight.semibold}",
        "lineHeight": "{typography.line-height.normal}",
        "letterSpacing": "{typography.letter-spacing.wider}"
      },
      "$description": "Uppercase labels (EMAIL, FROM SURFER)."
    },
    "metric": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.display}",
        "fontSize": "{typography.size.2xl}",
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": "{typography.line-height.tight}",
        "letterSpacing": "{typography.letter-spacing.none}"
      },
      "$description": "Numeric stat values."
    }
  },
  "elevation": {
    "action": {
      "$type": "shadow",
      "$value": "{shadow.glow-medium}",
      "$description": "Glow of the primary action."
    },
    "accent": {
      "$type": "shadow",
      "$value": "{shadow.glow-small}",
      "$description": "Subtle glow of avatars and highlighted badges."
    },
    "overlay": {
      "$type": "shadow",
      "$value": "{shadow.elevation-high}",
      "$description": "Modals, tooltips and menus."
    },
    "focus": {
      "$type": "shadow",
      "$value": "{shadow.ring}",
      "$description": "Visible keyboard focus ring."
    }
  },
  "motion": {
    "transition-fast": {
      "$type": "transition",
      "$value": {
        "duration": "{motion.duration.fast}",
        "delay": "0ms",
        "timingFunction": "{motion.easing.standard}"
      },
      "$description": "Hover and color changes."
    },
    "transition-base": {
      "$type": "transition",
      "$value": {
        "duration": "{motion.duration.base}",
        "delay": "0ms",
        "timingFunction": "{motion.easing.standard}"
      },
      "$description": "Expand/collapse, switches."
    },
    "transition-enter": {
      "$type": "transition",
      "$value": {
        "duration": "{motion.duration.slow}",
        "delay": "0ms",
        "timingFunction": "{motion.easing.enter}"
      },
      "$description": "Modal and toast entrance."
    },
    "reduced-duration": {
      "$type": "duration",
      "$value": "{motion.duration.instant}",
      "$description": "Duration when the user asks for reduced motion (prefers-reduced-motion)."
    },
    "loop-duration": {
      "$type": "duration",
      "$value": "{motion.duration.loop}",
      "$description": "One full cycle of looping animations (Spinner)."
    }
  },
  "layer": {
    "$description": "Stacking order by intent. Use these, never numeric z-index values.",
    "raised": {
      "$type": "number",
      "$value": "{z-index.raised}",
      "$description": "Elements above the content (cards on hover)."
    },
    "sticky": {
      "$type": "number",
      "$value": "{z-index.sticky}",
      "$description": "Sticky headers."
    },
    "dropdown": {
      "$type": "number",
      "$value": "{z-index.dropdown}",
      "$description": "Dropdown menus."
    },
    "modal": {
      "$type": "number",
      "$value": "{z-index.modal}",
      "$description": "Modals."
    },
    "toast": {
      "$type": "number",
      "$value": "{z-index.toast}",
      "$description": "Floating notifications."
    },
    "tooltip": {
      "$type": "number",
      "$value": "{z-index.tooltip}",
      "$description": "Tooltips, always on top."
    }
  }
}
