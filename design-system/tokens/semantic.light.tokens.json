{
  "$description": "Layer 2: light theme. Same paths as semantic.tokens.json; only redefines color. Loaded on top of the dark theme.",
  "color": {
    "background": {
      "canvas": {
        "$type": "color",
        "$value": "{color.navy.50}",
        "$description": "Page background. Lowest layer."
      },
      "surface": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Structural surfaces: sidebar, panels."
      },
      "surface-raised": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Cards, stats, lists and fields on the canvas."
      },
      "surface-sunken": {
        "$type": "color",
        "$value": "{color.navy.50}",
        "$description": "Sunken areas inside a card (surfer quote, notes block)."
      },
      "brand-subtle": {
        "$type": "color",
        "$value": "{color.ocean.50}",
        "$description": "Background of selected or brand-highlighted elements."
      },
      "highlight-subtle": {
        "$type": "color",
        "$value": "{color.sun.50}",
        "$description": "Background of plan badges and warm highlights."
      },
      "overlay": {
        "$type": "color",
        "$value": "{color.alpha.black.40}",
        "$description": "Scrim behind modals."
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.navy.900}",
        "$description": "Tooltip background."
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{color.navy.950}",
        "$description": "Primary text: headings, values, content."
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.navy.600}",
        "$description": "Supporting text: subtitles, metadata, stat labels."
      },
      "tertiary": {
        "$type": "color",
        "$value": "{color.navy.500}",
        "$description": "Low-priority text: placeholders, dates, metadata. Minimum contrast 4.5:1 on surface-raised."
      },
      "brand": {
        "$type": "color",
        "$value": "{color.ocean.700}",
        "$description": "Links and brand-colored text."
      },
      "highlight": {
        "$type": "color",
        "$value": "{color.sun.700}",
        "$description": "Warm highlighted text (surfer plan)."
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Text on inverse backgrounds (tooltips)."
      },
      "on-action": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Text on primary or destructive actions."
      },
      "disabled": {
        "$type": "color",
        "$value": "{color.navy.300}",
        "$description": "Text of disabled elements."
      },
      "muted": {
        "$type": "color",
        "$value": "{color.text.tertiary}",
        "$description": "Migration alias.",
        "$deprecated": "Use color.text.tertiary. 'muted' was this color's name in Coach Platform; kept as an alias until v2.0.0."
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "{color.alpha.navy.12}",
        "$description": "Default border for cards, fields and dividers."
      },
      "default": {
        "$type": "color",
        "$value": "{color.navy.200}",
        "$description": "Stronger border: unchecked checkbox and radio."
      },
      "strong": {
        "$type": "color",
        "$value": "{color.navy.400}",
        "$description": "High-contrast border: secondary button on hover."
      },
      "brand": {
        "$type": "color",
        "$value": "{color.ocean.600}",
        "$description": "Border of active or selected elements."
      },
      "focus": {
        "$type": "color",
        "$value": "{color.ocean.600}",
        "$description": "Visible focus border and ring."
      },
      "danger": {
        "$type": "color",
        "$value": "{color.coral.500}",
        "$description": "Border of fields with an error."
      }
    },
    "action": {
      "primary": {
        "background": {
          "$type": "color",
          "$value": "{color.ocean.700}",
          "$description": "Main action of the view. One per view. Darker than the original design so white text meets 4.5:1."
        },
        "background-start": {
          "$type": "color",
          "$value": "{color.ocean.800}",
          "$description": "Start of the primary button gradient. The original (#3b8eaa → #5aaec8) gave 2.5–3.7:1 with white text; ocean.800 → ocean.700 guarantees ≥ 5.4:1 across the whole gradient."
        },
        "background-end": {
          "$type": "color",
          "$value": "{color.ocean.700}",
          "$description": "End of the primary button gradient."
        },
        "background-hover": {
          "$type": "color",
          "$value": "{color.ocean.800}",
          "$description": "Main action on hover."
        },
        "background-pressed": {
          "$type": "color",
          "$value": "{color.ocean.900}",
          "$description": "Main action when pressed."
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.white}",
          "$description": "Text and icon on the main action."
        }
      },
      "secondary": {
        "background": {
          "$type": "color",
          "$value": "{color.white}",
          "$description": "Secondary action."
        },
        "background-hover": {
          "$type": "color",
          "$value": "{color.navy.50}",
          "$description": "Secondary action on hover."
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.navy.700}",
          "$description": "Secondary action text."
        },
        "border": {
          "$type": "color",
          "$value": "{color.navy.200}",
          "$description": "Secondary action border."
        }
      },
      "ghost": {
        "background-hover": {
          "$type": "color",
          "$value": "{color.ocean.50}",
          "$description": "Hover background of actions without a container."
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.ocean.700}",
          "$description": "Text of link-style actions."
        }
      },
      "danger": {
        "background": {
          "$type": "color",
          "$value": "{color.coral.600}",
          "$description": "Destructive action (cancel plan). Dark tone so white text meets 4.5:1."
        },
        "background-hover": {
          "$type": "color",
          "$value": "{color.coral.700}",
          "$description": "Destructive action on hover."
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.coral.600}",
          "$description": "Destructive action text without a container (Sign out)."
        }
      }
    },
    "feedback": {
      "success": {
        "foreground": {
          "$type": "color",
          "$value": "{color.green.700}"
        },
        "background": {
          "$type": "color",
          "$value": "{color.green.50}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.green.200}"
        }
      },
      "warning": {
        "foreground": {
          "$type": "color",
          "$value": "{color.amber.700}"
        },
        "background": {
          "$type": "color",
          "$value": "{color.amber.50}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.amber.200}"
        }
      },
      "danger": {
        "foreground": {
          "$type": "color",
          "$value": "{color.coral.600}"
        },
        "background": {
          "$type": "color",
          "$value": "{color.coral.50}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.coral.200}"
        }
      },
      "info": {
        "foreground": {
          "$type": "color",
          "$value": "{color.ocean.700}"
        },
        "background": {
          "$type": "color",
          "$value": "{color.ocean.50}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.ocean.200}"
        }
      },
      "neutral": {
        "foreground": {
          "$type": "color",
          "$value": "{color.navy.600}"
        },
        "background": {
          "$type": "color",
          "$value": "{color.gray.100}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.gray.200}"
        }
      }
    },
    "plan": {
      "pay-as-you-go": {
        "foreground": {
          "$type": "color",
          "$value": "{color.gray.600}",
          "$description": "Plan Pay as you go."
        },
        "background": {
          "$type": "color",
          "$value": "{color.gray.100}"
        }
      },
      "elite": {
        "foreground": {
          "$type": "color",
          "$value": "{color.amber.700}",
          "$description": "Plan Elite."
        },
        "background": {
          "$type": "color",
          "$value": "{color.amber.50}"
        }
      },
      "progression": {
        "foreground": {
          "$type": "color",
          "$value": "{color.violet.700}",
          "$description": "Plan Progression."
        },
        "background": {
          "$type": "color",
          "$value": "{color.violet.50}"
        }
      }
    },
    "status": {
      "pending": {
        "foreground": {
          "$type": "color",
          "$value": "{color.sun.700}",
          "$description": "Submission waiting for review."
        },
        "background": {
          "$type": "color",
          "$value": "{color.sun.50}"
        }
      },
      "in-review": {
        "foreground": {
          "$type": "color",
          "$value": "{color.ocean.700}",
          "$description": "Submission being reviewed by the coach."
        },
        "background": {
          "$type": "color",
          "$value": "{color.ocean.50}"
        }
      },
      "review-ready": {
        "foreground": {
          "$type": "color",
          "$value": "{color.green.700}",
          "$description": "Review ready to watch."
        },
        "background": {
          "$type": "color",
          "$value": "{color.green.50}"
        }
      },
      "overdue": {
        "foreground": {
          "$type": "color",
          "$value": "{color.coral.600}",
          "$description": "Review past its deadline."
        },
        "background": {
          "$type": "color",
          "$value": "{color.coral.50}"
        }
      }
    },
    "disabled": {
      "background": {
        "$type": "color",
        "$value": "{color.gray.100}",
        "$description": "Background of disabled controls."
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.gray.400}",
        "$description": "Text and icon of disabled controls."
      }
    },
    "icon": {
      "primary": {
        "$type": "color",
        "$value": "{color.navy.900}",
        "$description": "Default icons."
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.navy.500}",
        "$description": "Secondary icons (inactive navigation, chevrons)."
      },
      "brand": {
        "$type": "color",
        "$value": "{color.ocean.600}",
        "$description": "Active or brand icons."
      }
    }
  }
}
