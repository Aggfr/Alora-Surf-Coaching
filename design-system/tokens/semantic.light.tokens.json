{
  "$description": "Capa 2: tema claro. Mismas rutas que semantic.tokens.json; solo redefine color. Se carga encima del tema oscuro.",
  "color": {
    "background": {
      "canvas": {
        "$type": "color",
        "$value": "{color.navy.50}",
        "$description": "Fondo de la página. Capa más baja."
      },
      "surface": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Superficies estructurales: sidebar, paneles."
      },
      "surface-raised": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Tarjetas, stats, listas y campos sobre el canvas."
      },
      "surface-sunken": {
        "$type": "color",
        "$value": "{color.navy.50}",
        "$description": "Zonas hundidas dentro de una tarjeta (cita del surfer, bloque de notas)."
      },
      "brand-subtle": {
        "$type": "color",
        "$value": "{color.ocean.50}",
        "$description": "Fondo de elementos seleccionados o destacados con la marca."
      },
      "highlight-subtle": {
        "$type": "color",
        "$value": "{color.sun.50}",
        "$description": "Fondo de badges de plan y destacados cálidos."
      },
      "overlay": {
        "$type": "color",
        "$value": "{color.alpha.black.40}",
        "$description": "Velo detrás de modales."
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.navy.900}",
        "$description": "Fondo de tooltips."
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{color.navy.950}",
        "$description": "Texto principal: títulos, valores, contenido."
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.navy.600}",
        "$description": "Texto de apoyo: subtítulos, metadatos, labels de stats."
      },
      "tertiary": {
        "$type": "color",
        "$value": "{color.navy.500}",
        "$description": "Texto de baja prioridad: placeholders, fechas, metadatos. Contraste mínimo 4.5:1 sobre surface-raised."
      },
      "brand": {
        "$type": "color",
        "$value": "{color.ocean.700}",
        "$description": "Enlaces y texto con la marca."
      },
      "highlight": {
        "$type": "color",
        "$value": "{color.sun.700}",
        "$description": "Texto destacado cálido (plan del surfer)."
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Texto sobre fondos inversos (tooltips)."
      },
      "on-action": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Texto sobre acción primaria o destructiva."
      },
      "disabled": {
        "$type": "color",
        "$value": "{color.navy.300}",
        "$description": "Texto de elementos deshabilitados."
      },
      "muted": {
        "$type": "color",
        "$value": "{color.text.tertiary}",
        "$description": "Alias de migración.",
        "$deprecated": "Usar color.text.tertiary. 'muted' era el nombre de este color en Coach Platform; se mantiene como alias hasta la v2.0.0."
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "{color.alpha.navy.12}",
        "$description": "Borde por defecto de tarjetas, campos y divisores."
      },
      "default": {
        "$type": "color",
        "$value": "{color.navy.200}",
        "$description": "Borde con más presencia: checkbox, radio sin marcar."
      },
      "strong": {
        "$type": "color",
        "$value": "{color.navy.400}",
        "$description": "Borde de alto contraste: botón secundario en hover."
      },
      "brand": {
        "$type": "color",
        "$value": "{color.ocean.600}",
        "$description": "Borde de elementos activos o seleccionados."
      },
      "focus": {
        "$type": "color",
        "$value": "{color.ocean.600}",
        "$description": "Borde y anillo de foco visible."
      },
      "danger": {
        "$type": "color",
        "$value": "{color.coral.500}",
        "$description": "Borde de campos con error."
      }
    },
    "action": {
      "primary": {
        "background": {
          "$type": "color",
          "$value": "{color.ocean.700}",
          "$description": "Acción principal de la vista. Una por vista. Más oscuro que el diseño original para que el texto blanco cumpla 4.5:1."
        },
        "background-start": {
          "$type": "color",
          "$value": "{color.ocean.800}",
          "$description": "Inicio del degradado del botón primario. El original (#3b8eaa → #5aaec8) daba 2.5–3.7:1 con texto blanco; ocean.800 → ocean.700 garantiza ≥ 5.4:1 en todo el degradado."
        },
        "background-end": {
          "$type": "color",
          "$value": "{color.ocean.700}",
          "$description": "Fin del degradado del botón primario."
        },
        "background-hover": {
          "$type": "color",
          "$value": "{color.ocean.800}",
          "$description": "Acción principal en hover."
        },
        "background-pressed": {
          "$type": "color",
          "$value": "{color.ocean.900}",
          "$description": "Acción principal presionada."
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.white}",
          "$description": "Texto e icono sobre la acción principal."
        }
      },
      "secondary": {
        "background": {
          "$type": "color",
          "$value": "{color.white}",
          "$description": "Acción secundaria."
        },
        "background-hover": {
          "$type": "color",
          "$value": "{color.navy.50}",
          "$description": "Acción secundaria en hover."
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.navy.700}",
          "$description": "Texto de la acción secundaria."
        },
        "border": {
          "$type": "color",
          "$value": "{color.navy.200}",
          "$description": "Borde de la acción secundaria."
        }
      },
      "ghost": {
        "background-hover": {
          "$type": "color",
          "$value": "{color.ocean.50}",
          "$description": "Fondo en hover de acciones sin contenedor."
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.ocean.700}",
          "$description": "Texto de acciones tipo enlace."
        }
      },
      "danger": {
        "background": {
          "$type": "color",
          "$value": "{color.coral.600}",
          "$description": "Acción destructiva (cancelar plan). Tono oscuro para que el texto blanco cumpla 4.5:1."
        },
        "background-hover": {
          "$type": "color",
          "$value": "{color.coral.700}",
          "$description": "Acción destructiva en hover."
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.coral.600}",
          "$description": "Texto de acción destructiva sin contenedor (Sign out)."
        }
      }
    },
    "feedback": {
      "success": {
        "foreground": {
          "$type": "color",
          "$value": "{color.green.700}"
        },
        "background": {
          "$type": "color",
          "$value": "{color.green.50}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.green.200}"
        }
      },
      "warning": {
        "foreground": {
          "$type": "color",
          "$value": "{color.amber.700}"
        },
        "background": {
          "$type": "color",
          "$value": "{color.amber.50}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.amber.200}"
        }
      },
      "danger": {
        "foreground": {
          "$type": "color",
          "$value": "{color.coral.600}"
        },
        "background": {
          "$type": "color",
          "$value": "{color.coral.50}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.coral.200}"
        }
      },
      "info": {
        "foreground": {
          "$type": "color",
          "$value": "{color.ocean.700}"
        },
        "background": {
          "$type": "color",
          "$value": "{color.ocean.50}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.ocean.200}"
        }
      },
      "neutral": {
        "foreground": {
          "$type": "color",
          "$value": "{color.navy.600}"
        },
        "background": {
          "$type": "color",
          "$value": "{color.gray.100}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.gray.200}"
        }
      }
    },
    "plan": {
      "pay-as-you-go": {
        "foreground": {
          "$type": "color",
          "$value": "{color.gray.600}",
          "$description": "Plan Pay as you go."
        },
        "background": {
          "$type": "color",
          "$value": "{color.gray.100}"
        }
      },
      "elite": {
        "foreground": {
          "$type": "color",
          "$value": "{color.amber.700}",
          "$description": "Plan Elite."
        },
        "background": {
          "$type": "color",
          "$value": "{color.amber.50}"
        }
      },
      "progression": {
        "foreground": {
          "$type": "color",
          "$value": "{color.violet.700}",
          "$description": "Plan Progression."
        },
        "background": {
          "$type": "color",
          "$value": "{color.violet.50}"
        }
      }
    },
    "status": {
      "pending": {
        "foreground": {
          "$type": "color",
          "$value": "{color.sun.700}",
          "$description": "Envío pendiente de revisión."
        },
        "background": {
          "$type": "color",
          "$value": "{color.sun.50}"
        }
      },
      "in-review": {
        "foreground": {
          "$type": "color",
          "$value": "{color.ocean.700}",
          "$description": "Envío en revisión por el coach."
        },
        "background": {
          "$type": "color",
          "$value": "{color.ocean.50}"
        }
      },
      "review-ready": {
        "foreground": {
          "$type": "color",
          "$value": "{color.green.700}",
          "$description": "Revisión lista para ver."
        },
        "background": {
          "$type": "color",
          "$value": "{color.green.50}"
        }
      },
      "overdue": {
        "foreground": {
          "$type": "color",
          "$value": "{color.coral.600}",
          "$description": "Revisión fuera de plazo."
        },
        "background": {
          "$type": "color",
          "$value": "{color.coral.50}"
        }
      }
    },
    "disabled": {
      "background": {
        "$type": "color",
        "$value": "{color.gray.100}",
        "$description": "Fondo de controles deshabilitados."
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.gray.400}",
        "$description": "Texto e icono de controles deshabilitados."
      }
    },
    "icon": {
      "primary": {
        "$type": "color",
        "$value": "{color.navy.900}",
        "$description": "Iconos por defecto."
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.navy.500}",
        "$description": "Iconos secundarios (navegación inactiva, chevrons)."
      },
      "brand": {
        "$type": "color",
        "$value": "{color.ocean.600}",
        "$description": "Iconos activos o de marca."
      }
    }
  }
}
