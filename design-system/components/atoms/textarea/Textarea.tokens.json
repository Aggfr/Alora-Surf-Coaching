{
  "$description": "Tokens de Textarea. Fuente: tokens/component.tokens.json. Referencias semánticas adicionales que consume: input.*, typography.body-medium, typography.caption, color.text.tertiary.",
  "input": {
    "background": {
      "$type": "color",
      "$value": "{color.background.surface-raised}"
    },
    "foreground": {
      "$type": "color",
      "$value": "{color.text.primary}"
    },
    "placeholder": {
      "$type": "color",
      "$value": "{color.text.tertiary}"
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{color.border.subtle}"
      },
      "hover": {
        "$type": "color",
        "$value": "{color.border.strong}"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.border.focus}"
      },
      "error": {
        "$type": "color",
        "$value": "{color.border.danger}"
      }
    },
    "radius": {
      "$type": "dimension",
      "$value": "{size.radius.large}"
    },
    "padding-horizontal": {
      "$type": "dimension",
      "$value": "{size.space.medium}"
    },
    "typography": {
      "$type": "typography",
      "$value": "{typography.body-medium}"
    }
  }
}
