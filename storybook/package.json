    "@storybook/react-vite": "10.5.10",
    "@types/node": "^22.18.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "storybook": "10.5.10",
